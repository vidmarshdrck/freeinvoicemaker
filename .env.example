APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Generate a long random value before any public or networked use
SECRET_KEY=replace-with-a-long-random-secret

# First-run admin. Change immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

DATABASE_URL=sqlite:///storage/invoice_maker.db
STORAGE_PATH=storage

# Comma-separated origins in production. Do not use * with credentials.
CORS_ORIGINS=http://127.0.0.1:8000
